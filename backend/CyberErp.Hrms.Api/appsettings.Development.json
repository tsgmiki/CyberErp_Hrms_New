{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Seeds ONE named development account into an EXISTING tenant, so the API can be exercised
  // end-to-end without inventing a tenant or knowing anybody's real password. Development hosts
  // only, and only while Enabled is true AND Password is non-empty — there is no default password
  // and no default account name. CREATE-ONLY: an account that already exists is left completely
  // alone, so this can never reset anybody's credentials. The role must already exist in the
  // tenant and carry the privileges (in the live data that is "HR Admin", not "Administrator",
  // which holds zero permission rows).
  //
  // ⚠️ THE PASSWORD IS DELIBERATELY NOT IN THIS FILE. This file is committed, and the tenant below
  // holds real data — a working credential in git history is a credential you cannot take back.
  // Supply it out of band and it stays out of the repository:
  //
  //     dotnet user-secrets set "DevAdmin:Password" "<password>" --project CyberErp.Hrms.Api
  //     dotnet user-secrets set "DevAdmin:Enabled"  "true"       --project CyberErp.Hrms.Api
  //
  // Leaving Enabled false here means the seeder does nothing until somebody deliberately turns it
  // on for their own machine.
  "DevAdmin": {
    "Enabled": false,
    "TenantIdentifier": "headoffice",
    "UserName": "devadmin",
    "Password": "",
    "RoleName": "HR Admin",
    "Email": "devadmin@localhost.dev",
    "PhoneNumber": "0900000001"
  }
}
