# Development environment variables
VITE_API_BASE_URL=http://localhost:55900/api/v1
VITE_APP_NAME=Cyber HRMS Dev

# Subsystem WEB APPS — where each subsystem SPA lives, keyed by Core.Subsystem.Code
# (case-insensitive). The landing page deep-links to another subsystem through this.
# Replaces Core.Subsystem.Url, dropped on 2026-08-16 for SRMS schema parity. The Home portal
# reads the SAME variable name — keep the two in step.
VITE_SUBSYSTEM_APPS={"HOME":"http://localhost:5175","HRMS":"http://localhost:5174","srms":"http://localhost:5175","002":"http://localhost:5174"}
