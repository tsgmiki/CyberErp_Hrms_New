# Example environment variables
# Copy this file to .env.development or .env.production and fill in the values

VITE_API_BASE_URL=http://localhost:3000/api
VITE_APP_NAME=Cyber HRMS
# Optional: en | am
VITE_DEFAULT_LOCALE=en
# Subsystem WEB APPS — where each subsystem SPA lives, keyed by Core.Subsystem.Code
# (case-insensitive). The landing page deep-links to another subsystem through this.
# Replaces Core.Subsystem.Url, dropped on 2026-08-16 for SRMS schema parity. A subsystem missing
# from this map scopes locally instead of deep-linking.
VITE_SUBSYSTEM_APPS={"HOME":"http://localhost:5175","HRMS":"http://localhost:5174"}
